NODE_ENV=development
# Use the same port here and in GOOGLE_CALLBACK_URL (Google Cloud Console authorized redirect URIs must match).
PORT=8000
FRONTEND_URL=http://localhost:3000

# Optional: DB_SKIP=true uses in-memory store only (no Postgres).
# Postgres.app (macOS): postgresql://YOUR_MAC_USERNAME@localhost:5432/hiring_assistant
# Run: npm run db:setup -w backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiring_assistant

# Generate a long random string for production (e.g. openssl rand -base64 32).
JWT_SECRET=replace_with_a_long_random_secret

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Set S3_SKIP=true to store resumes on disk (backend/uploads/) — no real AWS keys needed for local dev.
# S3_SKIP=true
# PUBLIC_BASE_URL=http://localhost:8000
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional; default is gemini-2.5-flash (gemini-1.5-flash was removed from the API).
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# SMTP — REQUIRED together for email/password sign-up (verification codes).
# If any of HOST/USER/PASS is missing, codes are logged only (+ devCode in dev).
# Full reference: src/config/smtp.requirements.ts
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_account@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM="Hiring Assistant <your_account@gmail.com>"
